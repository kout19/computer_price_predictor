# Copy this file to `.env` and adjust values as needed.
# All variables are prefixed with APP_ to match Settings' env_prefix.

# --- API metadata ---
APP_API_TITLE="Computer Price Prediction API"
APP_API_VERSION=1.0.0
APP_API_V1_PREFIX=/api/v1

# --- Runtime environment ---
# One of: development, staging, production
APP_ENVIRONMENT=development
APP_DEBUG=false

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=INFO

# --- ML artifacts ---
# Paths are relative to the backend/ root (base_dir).
APP_ARTIFACTS_DIR=artifacts
APP_MODEL_FILENAME=computer_best_model.joblib
APP_PREPROCESSOR_FILENAME=computer_preprocessor.joblib

# --- CORS ---
# Comma-separated list is NOT auto-parsed by default; if you need to
# override this via env var, supply valid JSON, e.g.:
# APP_CORS_ALLOW_ORIGINS=["http://localhost:3000","https://yourapp.com"]